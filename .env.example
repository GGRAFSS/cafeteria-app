# Plantilla de variables de entorno para seed_supabase.py
# Uso: copia este archivo como ".env" y coloca los valores reales.
# IMPORTANTE: ".env" está en .gitignore y NUNCA debe subirse al repositorio.
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_KEY=<tu-anon-key>
# Opcional: modelo de Gemini para el analista IA (default: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash
